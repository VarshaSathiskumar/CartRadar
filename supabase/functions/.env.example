# Server secrets for the Edge Functions. Copy to supabase/functions/.env (git-ignored), fill in, then run:
#   npx supabase secrets set --env-file supabase/functions/.env --project-ref <ref>
# These never go in the app, in Vercel, or in git.

# Bee access token (Bearer). See the README for how far Bee's docs go on getting one.
BEE_TOKEN=

# OpenAI key and model for extract-items. The model must support structured outputs (json_schema).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Emails allowed to call either function, comma separated. With this empty nobody is allowed.
ALLOWED_EMAILS=

# Optional: override Bee's API host. Defaults to https://api.developer.bee.amazon.dev
# BEE_API_URL=
