# CartRadar global config.
# Copy this file to .env.local (git-ignored) and fill in the values. One file feeds the app, Expo and every server.
#
# Two kinds of values:
#   EXPO_PUBLIC_*  are copied into the app bundle. Anyone who opens the app can read them. URLs only, never secrets.
#   everything else stays on your machine and is read only by the servers in server/.

# ---------- Secrets and API keys (server side only) ----------

# OpenAI API key, used by server/extract.ts (npm run extract) to pull grocery items out of conversations.
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model used for extraction. Must support structured outputs (json_schema). Defaults to gpt-4o-mini if empty.
OPENAI_MODEL=gpt-4o-mini

# ---------- Supabase (login and cloud storage) ----------
# Create a project at https://supabase.com, then run supabase/migrations/0001_init.sql in its SQL editor.
# Project URL and anon key are under Project Settings, API. Both are public by design: row level security
# decides what each user can read, so they are safe in the bundle. NEVER put the service_role key in the app.
# Leave both empty to turn login off; the app then keeps everything on the device.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Email login: in Supabase, Authentication, Email Templates, "Magic Link", put {{ .Token }} in the message
# so the email carries the 6-digit code the login screen asks for.

# Google sign-in (browser only for now):
# 1. Create an OAuth client of type "Web application" at https://console.cloud.google.com/apis/credentials
#    and add http://localhost:8081 under "Authorized JavaScript origins".
# 2. In Supabase, Authentication, Providers, Google: enable it and enter that client id and secret.
# The client id is public, not a secret. The login screen only shows the Google button when this is set.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ---------- Server ports ----------
EXTRACT_PORT=8788

# ---------- App settings (public, shipped in the bundle) ----------

# Local `bee proxy` (run: bee proxy --port 8787). Reads your Bee account through the logged-in Bee CLI.
EXPO_PUBLIC_BEE_PROXY_URL=http://localhost:8787
# Local extraction service (npm run extract). Leave empty to use the built-in rule-based extractor.
EXPO_PUBLIC_EXTRACT_URL=http://127.0.0.1:8788
